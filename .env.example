# انسخ الملف إلى .env وعدّل بيانات قاعدة البيانات
APP_NAME="TARS × SHASHETY PRO"
APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost
APP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tars_portal
DB_USER=tars_portal
DB_PASS=CHANGE_ME
MAX_UPLOAD_GB=16
# 1 عند استخدام موقع Nginx المرفق (أفضل لتنزيل ملفات ISO كبيرة)
X_ACCEL_REDIRECT=0
